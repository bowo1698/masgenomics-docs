# Quarto build output
_site/
.quarto/

# Freeze cache: generally regenerated locally on render.
# EXCEPT: tutorial chunks under tasks/ call masreml/masbayes which CI does not
# install. Their freeze cache (cached chunk outputs + figures) must be shipped
# alongside the qmd source so CI renders from cache. See CLAUDE.md, rule 7.
_freeze/*
!_freeze/tasks

# R
.Rhistory
.RData
.Rproj.user/
.Rproj

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

/.quarto/
**/*.quarto_ipynb

# Internal planning 
docs/

# Local backups (created before edits to source files; never commit)
*.bak
*.bak.*
